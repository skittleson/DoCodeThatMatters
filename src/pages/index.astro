---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactInfo from '../components/ContactInfo.astro';
import { getCollection } from 'astro:content';
import { stripExt } from '../lib/markdownToText';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
);

// Curated best entry points — edit slugs here
const startHere = [
  'oauth-token-exchange-sso-demo',
  'm5-strix-halo-local-llm-server',
  'hacking-sony-a6000-for-modernization',
  'i-scanned-the-ble-devices-around-my-house',
];
const startHerePosts = startHere
  .map((slug) => posts.find((p) => p.id === `${slug}.md`))
  .filter((p): p is NonNullable<typeof p> => p != null);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<BaseLayout title="Do Code That Matters — Software, 3D Printing & DIY Blog">
  <main class="container mx-auto px-4 py-8" itemscope itemtype="https://schema.org/WebPage">
    <h1 itemprop="name" class="sr-only">Do Code That Matters - Home Page</h1>

    <div class="lg:grid lg:grid-cols-3 lg:gap-12">
      <!-- Post list -->
      <div class="lg:col-span-2" itemscope itemtype="http://schema.org/BreadcrumbList">
        <!-- Start here curated block -->
        <div class="rounded-lg border p-4 mb-6" style="background: var(--color-surface, #1e262f); border-color: var(--color-border, #2f3a45);">
          <h2 class="text-xs font-bold font-mono mb-3 uppercase tracking-wide" style="color: var(--color-text);">Start here</h2>
          <ul class="space-y-2">
            {startHerePosts.map((post) => (
              <li>
                <a
                  href={`/${stripExt(post.id)}/`}
                  style="color: var(--color-accent);"
                  class="hover:underline font-mono text-sm"
                >
                  {post.data.title}
                </a>
                {post.data.description && (
                  <span style="color: var(--color-text-muted);" class="font-mono text-sm ml-2">
                    — {post.data.description}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>

        {sortedPosts.map((post, index) => (
          <div
            itemprop="itemListElement"
            itemscope
            itemtype="http://schema.org/ListItem"
            class="mb-7 pb-7"
            style="border-bottom: 1px solid var(--color-border);"
          >
            <h2 class="text-lg font-bold mb-1 leading-snug">
              <a
                itemprop="item"
                href={`/${stripExt(post.id)}/`}
                style="color: var(--color-accent);"
                class="hover:underline"
              >
                <span itemprop="name">{post.data.title}</span>
              </a>
            </h2>
            <meta itemprop="position" content={String(index + 1)} />
            <div class="flex items-baseline gap-3 flex-wrap">
              {post.data.date && (
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-xs font-mono shrink-0"
                  style="color: var(--color-text-muted);"
                >
                  {formatDate(post.data.date)}
                </time>
              )}
              {post.data.description && (
                <p class="text-sm font-mono m-0" style="color: var(--color-text-muted);">
                  {post.data.description}
                </p>
              )}
            </div>
          </div>
        ))}

        <!-- Bottom CTA -->
        <p class="font-mono text-sm" style="color: var(--color-text-muted);">
          I write about what I build — and I build for clients too.
        </p>
        <a
          href="/about/#contact"
          class="inline-block text-sm px-4 py-2 rounded mt-4"
          style="background: var(--color-accent); color: var(--color-bg);"
        >
          Consulting &amp; contract work &rarr;
        </a>
      </div>

      <!-- Sidebar -->
      <aside class="mt-10 lg:mt-0">
        <ContactInfo />
      </aside>
    </div>
  </main>
</BaseLayout>
