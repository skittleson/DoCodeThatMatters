---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/blog.epub', label: 'EPUB' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<BaseLayout title="Page not found — Do Code That Matters">
  <main class="container mx-auto px-4 py-24 text-center max-w-xl">
    <figure class="mb-8">
      <picture>
        <source type="image/webp" srcset="/images/burnt-tantalum-capacitor.webp" />
        <img
          src="/images/burnt-tantalum-capacitor.jpg"
          alt="A burnt tantalum capacitor on a circuit board"
          width="900"
          height="900"
          class="rounded-md w-full max-w-[480px] mx-auto object-cover"
          loading="eager"
        />
      </picture>
      <figcaption class="mt-2 font-mono text-xs" style="color: var(--color-text-muted);">
        Photo:
        <a
          href="https://commons.wikimedia.org/wiki/File:Burnt_tantalum_capacitor_(23432017144).jpg"
          style="color: var(--color-accent);"
          class="hover:underline"
          target="_blank"
          rel="noopener"
        >
          htomari / Wikimedia Commons (CC BY-SA 2.0)
        </a>
      </figcaption>
    </figure>

    <h1 class="text-3xl font-bold mb-4" style="color: var(--color-text);">
      404 — Connection Reset by Hardware
    </h1>
    <p class="font-mono mb-8" style="color: var(--color-text-muted);">
      This page went the way of a tantalum capacitor: it looked fine, then it let out one last
      puff of smoke and stopped making contact.
    </p>

    <nav class="flex justify-center gap-6 font-mono text-sm">
      {links.map((l) => (
        <a href={l.href} style="color: var(--color-accent);" class="hover:underline">
          {l.label} &rarr;
        </a>
      ))}
    </nav>
  </main>
</BaseLayout>
