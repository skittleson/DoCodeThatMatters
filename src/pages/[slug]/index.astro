---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import type { GetStaticPaths } from 'astro';
import { stripExt } from '../../lib/markdownToText';

export const getStaticPaths: GetStaticPaths = async () => {
  // Drafts are built (semi-private: reachable by direct URL, noindex,
  // excluded from lists/feeds/sitemap) so they can be reviewed before publish.
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: stripExt(post.id) },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post}>
  <Content />
</PostLayout>
